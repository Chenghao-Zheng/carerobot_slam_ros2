<?xml version="1.0"?>
<robot name="STM32-V2-V1">

  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0335" rpy="0 0 0"/>
  </joint>

  <!-- 质量 1.5kg，重心 z=0.08，x/y 完全居中 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.0015" iyz="0" izz="0.0025" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_drive_gazebo/meshes/base_link.STL" />
      </geometry>
      <material name=""><color rgba="0.35 0.35 0.35 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://diff_drive_gazebo/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="RWheel_Link">
    <inertial>
      <origin xyz="-7.01586313839632E-05 2.36408023752827E-05 0.020662112756469" rpy="0 0 0" />
      <mass value="0.0586429819245853" />
      <inertia ixx="2.30450542160598E-05" ixy="1.51746238628924E-10" ixz="-3.38516692807764E-13"
               iyy="2.30454418604546E-05" iyz="1.62258203290037E-13" izz="4.10136614380478E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/RWheel_Link.STL" /></geometry>
      <material name=""><color rgba="0.55 0.55 0.55 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/RWheel_Link.STL" /></geometry>
    </collision>
  </link>

  <joint name="RWheel_Joint" type="continuous">
    <origin xyz="0 -0.064 0" rpy="-1.5708 0 3.1416" />
    <parent link="base_link" />
    <child link="RWheel_Link" />
    <axis xyz="0 0 -1" />
  </joint>

  <link name="LWheel_Link">
    <inertial>
      <origin xyz="7.15288358376486E-05 1.90166807518405E-05 0.0206621127565074" rpy="0 0 0" />
      <mass value="0.0586429819244516" />
      <inertia ixx="2.30450295086075E-05" ixy="-1.21437188655217E-10" ixz="-3.79280835276232E-13"
               iyy="2.30454665679065E-05" iyz="-1.77655810674022E-13" izz="4.10136614380474E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/LWheel_Link.STL" /></geometry>
      <material name=""><color rgba="0.55 0.55 0.55 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/LWheel_Link.STL" /></geometry>
    </collision>
  </link>

  <joint name="LWheel_Joint" type="continuous">
    <origin xyz="0 0.064 0" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="LWheel_Link" />
    <axis xyz="0 0 -1" />
  </joint>

  <link name="Camera_Link">
    <inertial>
      <origin xyz="0.0237939608894814 -0.00604094968678135 -0.000354987365072557" rpy="0 0 0" />
      <mass value="0.0148814712553841" />
      <inertia ixx="2.58332093274823E-06" ixy="-3.28268126125952E-08" ixz="-8.81706889210657E-09"
               iyy="3.64241351092798E-06" iyz="1.09446049153129E-09" izz="1.22892839873897E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/Camera_Link.STL" /></geometry>
      <material name=""><color rgba="0.5 0.5 0.5 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://diff_drive_gazebo/meshes/Camera_Link.STL" /></geometry>
    </collision>
  </link>

  <joint name="Camera_Joint" type="revolute">
    <origin xyz="0.055721 0 0.024677" rpy="1.5708 -1.5708 0" />
    <parent link="base_link" />
    <child link="Camera_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="1.63" effort="10" velocity="1.0" />
  </joint>

  <gazebo reference="RWheel_Link">
    <mu1>1.5</mu1><mu2>1.5</mu2><kp>1e6</kp><kd>100</kd>
    <minDepth>0.001</minDepth><material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="LWheel_Link">
    <mu1>1.5</mu1><mu2>1.5</mu2><kp>1e6</kp><kd>100</kd>
    <minDepth>0.001</minDepth><material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.1</mu1><mu2>0.1</mu2><kp>1e6</kp><kd>50</kd>
    <minDepth>0.001</minDepth><material>Gazebo/Grey</material>
  </gazebo>

  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>LWheel_Joint</left_joint>
      <right_joint>RWheel_Joint</right_joint>
      <wheel_separation>0.128</wheel_separation>
      <wheel_diameter>0.067</wheel_diameter>
      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>200.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <update_rate>100.0</update_rate>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30</update_rate>
      <joint_name>RWheel_Joint</joint_name>
      <joint_name>LWheel_Joint</joint_name>
      <joint_name>Camera_Joint</joint_name>
    </plugin>
  </gazebo>

</robot>